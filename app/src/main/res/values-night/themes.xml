<resources>
    <style name="Theme.DrawingFinalBoss" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/studio_rust</item>
        <item name="colorPrimaryVariant">@color/studio_ink</item>
        <item name="colorOnPrimary">@color/studio_paper</item>
        <item name="colorSecondary">@color/studio_rust</item>
        <item name="android:windowBackground">@color/studio_paper</item>
        <item name="android:statusBarColor">@color/studio_paper</item>
        <item name="android:navigationBarColor">@color/studio_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.DrawingFinalBoss.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/studio_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/studio_ink</item>
        <item name="postSplashScreenTheme">@style/Theme.DrawingFinalBoss</item>
    </style>
</resources>
